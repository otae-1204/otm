{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "otm",
  "identifier": "dev.otae.otm",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../app"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../app"
    },
    "frontendDist": "../../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "otm",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#14171c",
        "visible": false,
        "additionalBrowserArgs": "--disable-features=CalculateNativeWinOcclusion,msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "逃离塔科夫的外置地图"
  }
}
